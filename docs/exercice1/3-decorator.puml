@startuml
' Exercice 1.3 - Pattern Decorator
' Rattacher des responsabilités supplémentaires a traitement() sans
' modifier le composant : envelopper l'execution avant/après.

abstract class Composant {
  + traitement() : void
}

class ComposantConcret {
  + traitement() : void
}

abstract class Decorateur {
  - composant : Composant
  + traitement() : void
}

class DecorateurAvant {
  + traitement() : void
}

class DecorateurApres {
  + traitement() : void
}

Composant <|-- ComposantConcret
Composant <|-- Decorateur
Decorateur <|-- DecorateurAvant
Decorateur <|-- DecorateurApres
Decorateur o-- Composant : décore

@enduml
